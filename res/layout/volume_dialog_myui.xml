<!--
     Root view of the MyUI volume panel style. Collapsed it is a narrow glass column by the volume
     keys: the sound icon, one thin slider with its stream icon under it, and the dots that expand
     it, with the captions button as a circle of its own below. Expanded it is a centred
     "Sound & vibration" card of thin sliders with Done and Sound settings along the bottom.

     The ids are the ones the volume dialog view binders look for. There is no ringer drawer here,
     and VolumeDialogRingerViewBinder skips the card styles because of that.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/volume_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/volume_panel_myui_screen_margin"
    android:paddingEnd="@dimen/volume_panel_myui_screen_margin">

    <!-- The card. VolumeDialogSlidersViewBinder frosts this view's background. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/volume_dialog_myui_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/volume_panel_myui_background"
        android:clipChildren="false">

        <!-- Only here because the volume dialog binders look it up; the card is the background of
             its parent. -->
        <View
            android:id="@+id/volume_dialog_background"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/volume_dialog_myui_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/volume_panel_myui_header_height"
            android:layout_marginTop="@dimen/volume_panel_myui_padding"
            android:gravity="center"
            android:text="@string/volume_panel_myui_title"
            android:textColor="@color/volume_panel_myui_icon"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- The sound icon on top of the collapsed column. -->
        <ImageView
            android:id="@+id/volume_dialog_myui_sound_icon"
            android:layout_width="@dimen/volume_panel_myui_header_height"
            android:layout_height="@dimen/volume_panel_myui_header_height"
            android:layout_marginTop="@dimen/volume_panel_myui_padding"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_speaker_on"
            android:tint="@color/volume_panel_myui_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/volume_dialog_myui_title"/>

        <!-- Packed horizontal chain, so the collapsed column centres its single slider. -->
        <LinearLayout
            android:id="@+id/volume_dialog_floating_sliders_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/volume_panel_myui_slider_container_height"
            android:layout_marginStart="@dimen/volume_panel_myui_padding"
            android:divider="@drawable/volume_panel_myui_sliders_spacer"
            android:orientation="horizontal"
            android:showDividers="middle"
            app:layout_constraintEnd_toStartOf="@id/volume_dialog_main_slider_container"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/volume_dialog_main_slider_container"/>

        <include
            android:id="@+id/volume_dialog_main_slider_container"
            layout="@layout/volume_dialog_slider"
            android:layout_width="@dimen/volume_panel_myui_slider_width"
            android:layout_height="@dimen/volume_panel_myui_slider_container_height"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/volume_panel_myui_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/volume_dialog_floating_sliders_container"
            app:layout_constraintTop_toBottomOf="@id/volume_dialog_myui_sound_icon"/>

        <View
            android:id="@+id/volume_dialog_myui_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/volume_panel_myui_divider_inset"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/volume_panel_myui_divider_inset"
            android:background="@color/volume_panel_myui_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/volume_dialog_main_slider_container"/>

        <!-- Expands the collapsed column. -->
        <ImageButton
            android:id="@+id/volume_dialog_expand_collapsed"
            android:layout_width="@dimen/volume_panel_myui_header_height"
            android:layout_height="@dimen/volume_panel_myui_header_height"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/ripple_drawable_20dp"
            android:contentDescription="@string/volume_panel_expand"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:soundEffectsEnabled="false"
            android:src="@drawable/ic_volume_panel_oneui_more"
            android:tint="@color/volume_panel_myui_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/volume_dialog_myui_divider"/>

        <!-- Done and Sound settings along the bottom of the expanded card. -->
        <LinearLayout
            android:id="@+id/volume_dialog_myui_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/volume_panel_myui_divider_inset"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/volume_panel_myui_divider_inset"
            android:layout_marginBottom="@dimen/volume_panel_myui_footer_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/volume_dialog_myui_divider">

            <TextView
                android:id="@+id/volume_dialog_myui_done"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/volume_panel_myui_done_background"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:soundEffectsEnabled="false"
                android:text="@string/volume_panel_myui_done"
                android:textColor="@color/volume_panel_myui_icon"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/app_volume_icon"
                android:layout_width="@dimen/volume_panel_myui_header_height"
                android:layout_height="@dimen/volume_panel_myui_header_height"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_volume_settings"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:soundEffectsEnabled="false"
                android:src="@drawable/ic_app_volume"
                android:tint="@color/volume_panel_myui_icon"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/volume_dialog_settings"
                android:layout_width="@dimen/volume_panel_myui_header_height"
                android:layout_height="@dimen/volume_panel_myui_header_height"
                android:background="@drawable/ripple_drawable_20dp"
                android:contentDescription="@string/accessibility_volume_settings"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:soundEffectsEnabled="false"
                android:tint="@color/volume_panel_myui_icon"/>
        </LinearLayout>

        <!-- The expand binder needs this button; MyUI collapses from its Done button instead. -->
        <ImageButton
            android:id="@+id/volume_dialog_expand"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- The sliders view binder animates these two on overscroll. Gone, so that they take part
             in neither the layout nor the size the card wraps to. -->
        <View
            android:id="@+id/volume_dialog_top_section_container"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/volume_dialog_bottom_section_container"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.android.systemui.volume.CaptionsToggleImageButton
        android:id="@+id/odi_captions_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/volume_panel_myui_captions_size"
        android:layout_marginTop="10dp"
        android:background="@drawable/volume_panel_myui_captions_background"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:soundEffectsEnabled="false"
        android:src="@drawable/ic_volume_odi_captions_disabled"
        android:tint="@color/volume_panel_myui_icon"
        android:visibility="gone"/>

</LinearLayout>
