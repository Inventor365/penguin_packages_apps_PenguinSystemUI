<!-- The captions button under the MyUI column, rounded like the column: glass when off, the slider
     accent when on. Has to stay a transition drawable, VolumeDialogCaptionsButtonViewBinder
     cross-fades it. -->
<transition xmlns:android="http://schemas.android.com/apk/res/android"
            android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/volume_panel_myui_collapsed_corner_radius" />
            <solid android:color="@color/volume_panel_myui_background_fallback" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/volume_panel_myui_collapsed_corner_radius" />
            <solid android:color="@color/volume_panel_myui_track_active" />
        </shape>
    </item>
</transition>
