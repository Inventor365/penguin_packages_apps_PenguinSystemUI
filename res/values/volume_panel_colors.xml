<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Colors for the expandable volume panel style. The pills are drawn straight on top of the
         wallpaper with no card behind them, so these are fixed instead of following the theme: the
         wallpaper is whatever the user picked, and a themed pill would disappear into half of them. -->
    <color name="volume_panel_expandable_track_active">#FFFFFFFF</color>
    <!-- Translucent white rather than black: the empty part of a pill has to stay visible on a dark
         wallpaper, otherwise pills at different volumes look like pills of different heights. -->
    <color name="volume_panel_expandable_track_inactive">#4DFFFFFF</color>
    <color name="volume_panel_expandable_icon_on_active">#FF1B1B1F</color>
    <color name="volume_panel_expandable_icon_on_inactive">#FFFFFFFF</color>
    <!-- Buttons are darker than the pills so they read as controls, not as sliders. -->
    <color name="volume_panel_expandable_button_background">#59000000</color>
    <!-- Colors for the One UI volume panel style: white pills with dark icons on a frosted card.
         Fixed rather than themed, because the card is translucent over the wallpaper and these are
         the colors the design uses whichever theme is in use. -->
    <!-- Tint over the blurred wallpaper. -->
    <color name="volume_panel_oneui_background_blur">#4DFFFFFF</color>
    <!-- Card drawn when blur is unavailable: opaque, or the pills would sit on the wallpaper. -->
    <color name="volume_panel_oneui_background_fallback">#E6C7C7C9</color>
    <color name="volume_panel_oneui_track_active">#FFF7F7F7</color>
    <color name="volume_panel_oneui_track_inactive">#59FFFFFF</color>
    <color name="volume_panel_oneui_icon">#FF1B1B1B</color>
    <color name="volume_panel_oneui_label">#FF3C3C3C</color>
    <color name="volume_panel_oneui_button_selected">#33000000</color>
</resources>
