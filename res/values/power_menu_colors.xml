    <color name="power_menu_ios_thumb">#14F8F8F8</color>
    <color name="power_menu_ios_foreground">#FFFFFFFF</color>
    <color name="power_menu_ios_emergency_track">#33FF3B30</color>
    <color name="power_menu_ios_emergency_thumb">#4DFF3B30</color>
    <color name="power_menu_ios_emergency_foreground">#FFFF453A</color>
